# Question 1
# Multiply all the items in a list
# ==========================

numbers = [2, 3, 6]

result = 1
for num in numbers:
    result *= num

print("Question 1")
print("Result =", result)


# ==========================
# Question 2
# Sort a list of tuples by the last element
# ==========================

sample_list = [(2, 5), (1, 2), (4, 4), (2, 3), (2, 1)]

sample_list.sort(key=lambda x: x[-1])

print("\nQuestion 2")
print(sample_list)


# ==========================
# Question 3
# Combine two dictionaries
# ==========================

d1 = {'a': 100, 'b': 200, 'c': 300}
d2 = {'a': 300, 'b': 200, 'd': 400}

result = d1.copy()

for key, value in d2.items():
    if key in result:
        result[key] += value
    else:
        result[key] = value

print("\nQuestion 3")
print(result)


# ==========================
# Question 4
# Generate a dictionary (i : i*i)
# ==========================

n = int(input("\nQuestion 4\nEnter a number: "))

dictionary = {}

for i in range(1, n + 1):
    dictionary[i] = i * i

print(dictionary)


# ==========================
# Question 5
# Sort tuples by float value (descending)
# ==========================

items = [
    ('item1', '12.20'),
    ('item2', '15.10'),
    ('item3', '24.5')
]

items.sort(key=lambda x: float(x[1]), reverse=True)

print("\nQuestion 5")
print(items)


